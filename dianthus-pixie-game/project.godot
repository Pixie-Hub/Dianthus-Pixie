[layer_names]

2d_physics/layer_1="interactable"
2d_physics/layer_2="terrain"
2d_physics/layer_3="player"
2d_physics/layer_4="enemy"
2d_physics/layer_5="projectile"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[resource]

resource/tutor_step="res://accessibility/tutorial/tutorial_step.gd"
resource/tutor_data="res://accessibility/tutorial/tutorial_data.gd"
