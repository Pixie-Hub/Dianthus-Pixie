; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dianthus Pixie Game"
run/main_scene="res://ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://shared/autoloads/game_manager.gd"
PauseManager="*res://shared/autoloads/pause_manager.gd"
DayNightCycle="*res://core/day_night/day_night_cycle.gd"
SceneTransition="*res://core/transitions/scene_transition.gd"
SaveManager="*res://save/scripts/save_manager.gd"
DifficultyManager="*res://accessibility/difficulty/difficulty_manager.gd"
InventoryManager="*res://inventory/scripts/inventory_manager.gd"
CraftingManager="*res://crafting/scripts/crafting_manager.gd"
BreedingManager="*res://crafting/breeding/breeding_manager.gd"
CodexManager="*res://ui/codex/codex_manager.gd"
QuestManager="*res://quests/scripts/quest_manager.gd"
ZoneTracker="*res://world/scripts/zone_tracker.gd"
UnlockFlags="*res://shared/autoloads/unlock_flags.gd"
DailyQuestRoller="*res://quests/scripts/daily_quest_roller.gd"
EndingManager="*res://core/endings/ending_manager.gd"
EndlessLeaderboard="*res://save/scripts/endless_leaderboard.gd"
SfxManager="*res://audio/sfx_manager.gd"
MusicManager="*res://audio/music_manager.gd"
Dialogic="*uid://ds2q0uclmolvu"
TutorialManager="*res://accessibility/tutorial/tutorial_manager.gd"

[dialogic]

directories/dtl_directory={
"access_03_tutorial": "res://dialogic/timelines/access_03_tutorial.dtl",
"tutorial_complete": "res://dialogic/timelines/access_03_tutorial.dtl"
}
directories/dch_directory={
"Dianthus Core": "res://dialogic/characters/Dianthus Core.dch"
}
layout/style_directory={
"Cutscene": "res://dialogic/styles/Cutscene.tres",
"Gameplay": "res://dialogic/styles/Gameplay.tres",
"Tutorial": "res://dialogic/styles/Tutorial.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://dialogic/styles/Gameplay.tres", "res://dialogic/styles/Cutscene.tres", "res://dialogic/styles/Tutorial.tres"]
layout/default_style=""
variables={}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[global_group]

wave_spawners=""

