[gd_resource type="Resource" script_class="QuestData" load_steps=3 format=3]

[ext_resource type="Script" path="res://quests/data/quest_data.gd" id="1_qdata"]
[ext_resource type="Script" path="res://quests/data/quest_objective.gd" id="2_qobj"]

[sub_resource type="Resource" id="Resource_obj1"]
script = ExtResource("2_qobj")
objective_id = &"collect_50_petal_shards"
description = "Collect 50 Petal Shard total"
event_id = &"item_collected"
target_count = 50
filter = {"item_id": "petal_shard"}

[resource]
script = ExtResource("1_qdata")
quest_id = &"progress_collect_50_shards"
display_name = "Petal Hoarder"
description = "The garden thrives on abundance. Accumulate 50 Petal Shards from the meadow over time."
quest_type = 1
objectives = Array[ExtResource("2_qobj")]([SubResource("Resource_obj1")])
reward_items = {"kecombrang_seed": 1}
reward_weapons = []
reward_unlock_flags = []
time_limit_days = 0
dialogic_timeline_on_complete = ""
dialogic_timeline_on_fail = ""
next_quest_id = &""
auto_start = true
