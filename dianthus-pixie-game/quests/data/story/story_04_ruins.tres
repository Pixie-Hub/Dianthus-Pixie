[gd_resource type="Resource" script_class="QuestData" load_steps=3 format=3]

[ext_resource type="Script" path="res://quests/data/quest_data.gd" id="1_qdata"]
[ext_resource type="Script" path="res://quests/data/quest_objective.gd" id="2_qobj"]

[sub_resource type="Resource" id="Resource_obj1"]
script = ExtResource("2_qobj")
objective_id = &"collect_blackwater_aether_bloom"
description = "Gather 1 Aether Bloom from Blackwater Hollow"
event_id = &"item_collected"
target_count = 1
filter = {"item_id": "aether_bloom"}

[resource]
script = ExtResource("1_qdata")
quest_id = &"story_04_ruins"
display_name = "Roots Beneath Blackwater"
description = "Dusk Forest is sheltering an old road beneath Blackwater Hollow. Bring back an Aether Bloom so the Core can remember where the road goes."
quest_type = 3
objectives = Array[ExtResource("2_qobj")]([SubResource("Resource_obj1")])
reward_items = {}
reward_weapons = []
reward_unlock_flags = ["unlock_zone_ruins"]
time_limit_days = 5
dialogic_timeline_on_complete = "res://dialogic/timelines/story_04_complete.dtl"
dialogic_timeline_on_fail = "res://dialogic/timelines/story_04_fail.dtl"
next_quest_id = &"story_05_devourer_omens"
auto_start = false
failure_unlock_flags = ["flag_story_failed_ruins"]
failure_next_quest_id = &"story_alt_lost"
