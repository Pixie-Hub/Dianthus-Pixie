[gd_resource type="Resource" script_class="QuestData" load_steps=5 format=3]

[ext_resource type="Script" path="res://quests/data/quest_data.gd" id="1_qdata"]
[ext_resource type="Script" path="res://quests/data/quest_objective.gd" id="2_qobj"]

[sub_resource type="Resource" id="Resource_hit"]
script = ExtResource("2_qobj")
objective_id = &"hit_shadow_creature"
description = "Hit a shadow creature"
event_id = &"tutorial_enemy_hit"
target_count = 1
filter = {}

[sub_resource type="Resource" id="Resource_survive"]
script = ExtResource("2_qobj")
objective_id = &"survive_night_1"
description = "Survive Night 1 with the Core intact"
event_id = &"tutorial_night1_survived"
target_count = 1
filter = {"night": 1}

[resource]
script = ExtResource("1_qdata")
quest_id = &"tutorial_day1_combat"
display_name = "Defend the Heart"
description = "Strike a shadow creature and survive the first night."
quest_type = 3
objectives = Array[ExtResource("2_qobj")]([SubResource("Resource_hit"), SubResource("Resource_survive")])
reward_items = {}
reward_weapons = []
reward_unlock_flags = []
time_limit_days = 0
dialogic_timeline_on_complete = ""
dialogic_timeline_on_fail = ""
next_quest_id = &""
auto_start = false
failure_unlock_flags = []
failure_next_quest_id = &""
