[gd_scene format=3]

[ext_resource type="Script" path="res://ui/screens/night_survived_screen.gd" id="1_script"]

[node name="NightSurvivedScreen" type="CanvasLayer"]
process_mode = 3
layer = 100
visible = false
script = ExtResource("1_script")

[node name="ColorRect" type="ColorRect" parent="."]
process_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.75)

[node name="CenterContainer" type="CenterContainer" parent="ColorRect"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="ColorRect/CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="TitleLabel" type="Label" parent="ColorRect/CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.3, 1)
theme_override_font_sizes/font_size = 24
text = "NIGHT SURVIVED!"
horizontal_alignment = 1

[node name="DayLabel" type="Label" parent="ColorRect/CenterContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "Day 1 Complete"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="ColorRect/CenterContainer/VBoxContainer"]
layout_mode = 2

[node name="RewardsTitle" type="Label" parent="ColorRect/CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 8
text = "Rewards:"
horizontal_alignment = 1

[node name="RewardsLabel" type="Label" parent="ColorRect/CenterContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.9, 0.6, 1)
theme_override_font_sizes/font_size = 8
text = "+ 3 Petal Shard
+ 1 Verdant Sap"
horizontal_alignment = 1

[node name="HSeparator2" type="HSeparator" parent="ColorRect/CenterContainer/VBoxContainer"]
layout_mode = 2

[node name="ContinueButton" type="Button" parent="ColorRect/CenterContainer/VBoxContainer"]
unique_name_in_owner = true
process_mode = 3
custom_minimum_size = Vector2(120, 30)
layout_mode = 2
text = "Continue"

[connection signal="pressed" from="ColorRect/CenterContainer/VBoxContainer/ContinueButton" to="." method="_on_continue"]
